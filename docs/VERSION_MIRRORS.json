[
  {
    "path": "src/B47ANCEDEarthworks/42/mod.info",
    "pattern": "^modversion=(.+)$"
  },
  {
    "path": "src/B47ANCEDEarthworks/info.txt",
    "pattern": "^Version: (.+)$"
  },
  {
    "path": "src/B47ANCEDEarthworks/42/media/lua/shared/groundWorks/API.lua",
    "pattern": "groundWorks\\.VERSION=\"([^\"]+)\""
  },
  {
    "path": "README.md",
