  },
  {
    "path": "WORKSHOP_DESCRIPTION.txt",
    "pattern": "^\\[b\\]Mod Version: (.+?)\\[/b\\]"
  },
  {
    "path": "WORKSHOP_CHANGE_NOTE.txt",
    "pattern": "^\\[b\\]Version (.+?)\\[/b\\]"
  },
  {
    "path": "workshop.txt",
    "pattern": "^description=\\[b\\]Mod Version: (.+?)\\[/b\\]"
  },
  {
    "path": "workshop.txt",
    "pattern": "^changenote=\\[b\\]Version (.+?)\\[/b\\]"
  },
  {
    "path": "docs/CURRENT_STATUS.md",
    "pattern": "^Version: (.+)$"
  },
  {
    "path": "docs/VALIDATION_CURRENT.md",
    "pattern": "^Version: (.+)$"
  },
  {
    "path": "docs/ARCHITECTURE_CURRENT.md",
    "pattern": "^Version: (.+)$"
  },
  {
    "path": "docs/CONFIGURATION.md",
    "pattern": "^Version: (.+)$"
  },
  {
    "path": "docs/COMPATIBILITY.md",
    "pattern": "^Version: (.+)$"
  },
  {
    "path": "docs/SOURCE_PROVENANCE_CURRENT.json",
    "pattern": "\"version\": \"([^\"]+)\""
  }
]
